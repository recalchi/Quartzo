# Quartzo — configuração do Firebase (mesmo projeto do Recalchi Manage: recalchi-manage)
# Copie para .env e preencha com o objeto firebaseConfig do console do Firebase
# (Configurações do projeto -> Seus apps -> Web). São chaves públicas de cliente;
# a proteção real dos dados está nas regras do Firestore (docs/firestore.rules.quartzo).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=recalchi-manage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=recalchi-manage
VITE_FIREBASE_STORAGE_BUCKET=recalchi-manage.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do Recalchi Manage (link "abrir no Manage" e integração futura)
VITE_RECALCHI_MANAGE_URL=https://recalchi.com.br
