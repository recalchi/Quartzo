{
  "name": "quartzo",
  "productName": "Quartzo",
  "private": true,
  "version": "0.4.0",
  "description": "Quartzo — notas em Markdown conectadas, local-first e sincronizadas com o Recalchi Manage.",
  "author": "Renan Recalchi",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/build-icons.mjs",
    "desktop": "npm run build:electron && electron .",
    "desktop:dist": "npm run build:electron && electron-builder --win portable",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.5",
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.2.6",
    "firebase": "^12.15.0",
    "jszip": "^3.10.1",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.2",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  },
  "build": {
    "appId": "br.com.recalchi.quartzo",
    "productName": "Quartzo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Quartzo-${version}-portable.exe"
    }
  }
}
